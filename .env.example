

# ==================== 玄剑姬 RAG 问答 ====================
# 加密主密钥：用于 AES-256-GCM 加密保存 Embedding/LLM 的 API Key。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未配置时后台无法保存密钥（会明确提示），已配置的密钥也无法解密。
RAG_SECRET_KEY=

# 可选：直接用环境变量提供模型密钥（后台未配置时生效；优先级低于后台加密存储）
RAG_EMBEDDING_KEY=
RAG_LLM_KEY=

# 可选：关闭后台索引 worker（测试/脚本环境用）
RAG_DISABLE_WORKER=0
