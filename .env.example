PORT=3000
NODE_ENV=production

# JWT密钥 - 必须设置强随机字符串
JWT_SECRET=

# 管理员初始密码 - 必须设置强密码
ADMIN_PASSWORD=

# SMTP邮件配置
SMTP_USER=xuanjian_guild@xuanjian.top
SMTP_PASS=

# 网站地址
SITE_URL=https://xuanjian.top

# QQ登录（心月互联）Token - 在 https://qq.wch666.com 申请，30天有效期
# 申请时回调地址需填写：本地测试 http://localhost:3000/api/auth/qq/callback
QQ_LOGIN_TOKEN=
